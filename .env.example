# Copy to .env for local work. Never commit real values.
# Production values live in Vercel → Settings → Environment Variables (Production only).

# --- Database (Turso / libSQL) ---
# Production only. Local dev uses file:.data/dev.db unless DB_TARGET=turso.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-turso-token"
# DB_TARGET="turso"               # dev only: point the local server at Turso (careful: real data)
# LOCAL_DB_URL="file:.data/dev.db" # dev/test local file database

# --- Email (Resend) ---
RESEND_API_KEY="re_your_key"
# Sender shown to students. Must be on the Resend-verified domain.
EMAIL_FROM="Priyanshi · YogaPriyanshi <priyanshi@yogapriyanshi.com>"
# EMAIL_TRANSPORT="resend"         # dev only: really send instead of logging

# --- Admin ---
# scrypt hash from: read -s PW && printf '%s' "$PW" | npm run -s hash-password; unset PW
# Admin sign-in returns 503 until this is set.
ADMIN_PASSWORD_HASH="scrypt$<salt-b64>$<hash-b64>"

# Off Vercel only: set to 1 together with NODE_ENV=production to let this machine use the live database and email. Leave unset.
# ALLOW_LIVE=
